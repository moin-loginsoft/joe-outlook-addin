{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "WebAppName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "metadata": {
        "description": "Name of the Azure Web App. It forms the public domain (<name>.azurewebsites.net) used by the Outlook add-in."
      }
    },
    "Sku": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": ["B1", "B2", "B3", "S1", "S2", "S3", "P1v3", "P2v3"],
      "metadata": {
        "description": "App Service pricing tier. S1 or higher is recommended for production."
      }
    },
    "AzureTenantID": {
      "type": "string",
      "minLength": 1,
      "metadata": {
        "description": "Directory (tenant) ID of the App Registration."
      }
    },
    "AzureClientID": {
      "type": "string",
      "minLength": 1,
      "metadata": {
        "description": "Application (client) ID of the App Registration."
      }
    },
    "AzureClientSecret": {
      "type": "securestring",
      "minLength": 1,
      "metadata": {
        "description": "Client secret value of the App Registration."
      }
    },
    "JoeSandboxApiUrl": {
      "type": "string",
      "defaultValue": "https://jbxcloud.joesecurity.org/api",
      "metadata": {
        "description": "Joe Sandbox API URL. Keep the default for Joe Sandbox Cloud; for on-premise use http(s)://<server>/joesandbox/index.php/api."
      }
    },
    "JoeSandboxApiKey": {
      "type": "securestring",
      "minLength": 1,
      "metadata": {
        "description": "Joe Sandbox API key used for submissions."
      }
    },
    "AcceptJoeSandboxTermsAndConditions": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Accept the Joe Sandbox Cloud Terms and Conditions (https://jbxcloud.joesecurity.org/resources/termsandconditions.pdf). Required for Joe Sandbox Cloud."
      }
    },
    "AnalyzeOnJoeReverser": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Also analyze reported emails with Joe Reverser. The Joe Sandbox account must include Joe Reverser."
      }
    },
    "MoveReportedEmailToFolder": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Move the reported email to a mail folder after a successful submission."
      }
    },
    "ReportedEmailFolderName": {
      "type": "string",
      "defaultValue": "Phishing Report",
      "metadata": {
        "description": "Name of the top-level mail folder that reported emails are moved to. It is created if it does not exist."
      }
    },
    "MaxEmailSizeMB": {
      "type": "int",
      "defaultValue": 25,
      "minValue": 1,
      "maxValue": 100,
      "metadata": {
        "description": "Maximum size (MB) of an email that may be submitted."
      }
    },
    "DeploymentTimestamp": {
      "type": "string",
      "defaultValue": "[utcNow()]",
      "metadata": {
        "description": "Leave as is. Makes the wait before deploying the package run on every deployment."
      }
    },
    "PackageUrl": {
      "type": "string",
      "defaultValue": "https://github.com/{JOE_GITHUB_ORG}/{JOE_REPOSITORY}/raw/main/deploy/source.zip",
      "metadata": {
        "description": "URL of the add-in package (source.zip) to deploy."
      }
    }
  },
  "variables": {
    "planName": "[concat(parameters('WebAppName'), '-plan')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-09-01",
      "name": "[variables('planName')]",
      "location": "[resourceGroup().location]",
      "sku": {
        "name": "[parameters('Sku')]"
      },
      "kind": "linux",
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-09-01",
      "name": "[parameters('WebAppName')]",
      "location": "[resourceGroup().location]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"
      ],
      "kind": "app,linux",
      "properties": {
        "httpsOnly": true,
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "siteConfig": {
          "linuxFxVersion": "PYTHON|3.12",
          "appCommandLine": "sh startup.sh",
          "alwaysOn": true,
          "http20Enabled": true,
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "healthCheckPath": "/health",
          "appSettings": [
            { "name": "SCM_DO_BUILD_DURING_DEPLOYMENT", "value": "false" },
            { "name": "ENABLE_ORYX_BUILD", "value": "false" },
            { "name": "AZURE_TENANT_ID", "value": "[parameters('AzureTenantID')]" },
            { "name": "AZURE_CLIENT_ID", "value": "[parameters('AzureClientID')]" },
            { "name": "AZURE_CLIENT_SECRET", "value": "[parameters('AzureClientSecret')]" },
            { "name": "JOE_API_URL", "value": "[parameters('JoeSandboxApiUrl')]" },
            { "name": "JOE_API_KEY", "value": "[parameters('JoeSandboxApiKey')]" },
            { "name": "JOE_ACCEPT_TAC", "value": "[if(parameters('AcceptJoeSandboxTermsAndConditions'), 'true', 'false')]" },
            { "name": "JOE_ANALYZE_ON_REVERSER", "value": "[if(parameters('AnalyzeOnJoeReverser'), 'true', 'false')]" },
            { "name": "MOVE_REPORTED_EMAIL_TO_FOLDER", "value": "[if(parameters('MoveReportedEmailToFolder'), 'true', 'false')]" },
            { "name": "REPORTED_EMAIL_FOLDER_NAME", "value": "[parameters('ReportedEmailFolderName')]" },
            { "name": "MAX_EMAIL_SIZE_MB", "value": "[string(parameters('MaxEmailSizeMB'))]" }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Resources/deploymentScripts",
      "apiVersion": "2020-10-01",
      "name": "waitForWebApp",
      "location": "[resourceGroup().location]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('WebAppName'))]"
      ],
      "kind": "AzurePowerShell",
      "properties": {
        "azPowerShellVersion": "11.0",
        "scriptContent": "Start-Sleep -Seconds 60",
        "forceUpdateTag": "[parameters('DeploymentTimestamp')]",
        "cleanupPreference": "Always",
        "retentionInterval": "PT1H"
      }
    },
    {
      "type": "Microsoft.Web/sites/extensions",
      "apiVersion": "2022-09-01",
      "name": "[concat(parameters('WebAppName'), '/zipdeploy')]",
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deploymentScripts', 'waitForWebApp')]"
      ],
      "properties": {
        "packageUri": "[parameters('PackageUrl')]"
      }
    }
  ],
  "outputs": {
    "WebAppURL": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.Web/sites', parameters('WebAppName'))).defaultHostName)]"
    },
    "ManifestURL": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.Web/sites', parameters('WebAppName'))).defaultHostName, '/manifest.xml')]"
    }
  }
}
